  - state: happy
    animatorState: KA_Idle28_Laugh
    fallbackAnimatorState: KA_Idle01_breathing
    crossFadeSeconds: 0.36
  - state: angry
    animatorState: KA_Idle27_Angry
    fallbackAnimatorState: KA_Idle01_breathing
    crossFadeSeconds: 0.36
  - state: sleepy
    animatorState: KA_Idle09_Waiting
    fallbackAnimatorState: KA_Idle01_breathing
    crossFadeSeconds: 0.36
  - state: surprised
    animatorState: KA_Idle29_Surprised
    fallbackAnimatorState: KA_Idle01_breathing
    crossFadeSeconds: 0.36
  - state: clicked
    animatorState: KA_Idle29_Surprised
    fallbackAnimatorState: KA_Idle01_breathing
    crossFadeSeconds: 0.36
  - state: interrupted
    animatorState: KA_Idle29_Surprised
