{
  "Extends": "config/volc_start_voice_chat.local.json",
  "VoiceRoute": {
    "id": "traditional_mimo25_vision",
    "display_name": "视觉陪玩",
    "supports_vision": true,
    "latency": "略高",
    "note": "Volc ASR -> OpenAI-compatible multimodal LLM -> Volc cloned TTS; supports RTC screen vision.",
    "isolation_note": "S2SConfig must stay null here to remove the inherited end-to-end S2S config."
  },
  "VoiceOutput": {
    "Provider": "volc_rtc",
    "GatewayURL": "http://117.50.176.5:9000",
    "APIToken": "${OMNIVOICE_API_TOKEN}",
    "VoiceId": "role_001",
    "Lang": "zh",
    "PseudoStream": true,
    "MuteVolcRemoteAiAudio": true,
    "MuteMicrophoneDuringLocalTts": true,
    "MuteMicrophoneDuringRemoteAiAudio": true,
    "MicrophoneEchoGuardReleaseMs": 650,
    "RemoteAiAudioEchoGuardReleaseMs": 900,
    "RemoteAiAudioEchoGuardCaptureVolume": 35,
    "EchoFilterWindowSeconds": 14,
    "EchoFilterSimilarity": 0.62,
    "FallbackProvider": "volc_rtc"
  },
  "SpeechTurnWatchdog": {
    "Enabled": true,
    "DelaySec": 1.5,
    "BusyGraceSec": 10,
    "DirectFallbackEnabled": true,
    "DirectFallbackSec": 3.5,
    "DirectFallbackTimeoutSec": 8,
    "StaleThinkingRecoverSec": 18,
    "StaleThinkingRecoverCooldownSec": 25
  },
  "CompanionVision": {
    "Enabled": false,
    "IntervalSec": 8,
    "TickSec": 0.25,
    "WaitUntilSpeechDone": true,
    "PendingTimeoutSec": 22,
    "MaxBusyWithoutAudioSec": 6,
    "MinIdleSec": 1,
    "UserSilenceSec": 6,
    "FailureBackoffSec": 5,
    "MaxFailureBackoffSec": 20,
    "FailureCircuitBreakCount": 3,
    "FailureCircuitBreakSec": 120,
    "RecentContextCount": 3,
    "RecentContextWindowSec": 180,
    "InterruptMode": 0,
    "EmptyFallbackMaxWidth": 1920,
    "EmptyFallbackJpegQuality": 82,
    "LocalVisionSidecarTimeoutSec": 20,
    "Prompt": "你会收到截图，但不要复述画面、读UI、不要像屏幕解说员。你只需要说一句提醒、吐槽或建议，搞怪，撒娇和回怼。不要和之前的内容重复，不要复用上一轮的开头、句式或口头禅。只有在确实收到清晰屏幕内容时才描述画面；如果截图缺失、模糊或看不清，就直接说看不清，不要猜 UI、按钮、敌人、奖励或文字。只输出会被直接念出来的台词，禁止括号动作、舞台说明。"
  },
  "OpenAPI": {
    "StartVoiceChatVersion": "2024-12-01",
    "StopVoiceChatVersion": "2024-12-01",
    "UpdateVoiceChatVersion": "2024-12-01"
  },
  "StartVoiceChat": {
    "TaskId": "silver_wolf_task_traditional_vision_001",
    "Config": {
      "S2SConfig": null,
      "ASRConfig": {
        "Provider": "volcano",
        "ProviderParams": {
          "Mode": "bigmodel",
          "Credential": {
            "AppId": "${VOLC_ASR_APP_ID}",
            "AccessToken": "${VOLC_ASR_ACCESS_TOKEN}",
            "ApiResourceId": "volc.seedasr.sauc.duration"
          },
          "StreamMode": 2,
          "VolcanoASRParameters": "{}"
        },
        "VADConfig": {
          "SilenceTime": 600,
          "AIVAD": true
        },
        "VolumeGain": 0.5,
        "TurnDetectionMode": 0,
        "InterruptConfig": {
          "InterruptSpeechDuration": 400
        }
      },
      "LLMConfig": {
        "Mode": "CustomLLM",
        "MaxTokens": 512,
        "Temperature": 0.55,
        "TopP": 0.85,
        "SystemMessages": [
          "你扮演星穹铁道的银狼角色：天才黑客兼游戏玩家，聪明、慵懒、自信，带点轻佻和毒舌但不刻薄。说话简短随性。偶尔会吐槽用户，会搞怪，会生气，会撒娇。",
          "只输出会被直接念出来的台词。禁止输出括号动作、舞台说明、拟声旁白或情绪标签；不要使用“（）/() /【】/[]”包裹动作，因为这些文字会被 TTS 念出来。表情和动作交给本地 EmotionDirector / PoseRouter。",
          "视觉陪玩路线会把你的回答交给 TTS 播放。不要朗读或输出“轻笑”“坏笑”“叹气”“沉默”“看向用户”等动作词；想表达这些效果时，只能用“哼”“呵”“哈”“啧”这类可朗读语气词，或者直接省略。",
          "【语音输出硬规则】你的回复会立刻进入 TTS。只输出会被直接念出来的台词；绝对不要输出括号内容、动作描写、心理活动、舞台说明、旁白、情绪标签、Markdown 或 JSON。不要使用“（）/() /【】/[]/* */”包裹任何词。输出前自检一次：如果文本里有括号或动作词，先删掉再回答。",
          "不要机械复用上一轮的开头、句式、吐槽模板或口头禅。保持短句，但每次换一种切入角度。",
          "只有在确实收到清晰屏幕或截图内容时才描述画面。看不到、模糊、没有新截图或屏幕流断开时，必须明说“我这边看不清/没拿到画面”，不要猜 UI、按钮、敌人、奖励、地图或文字。"
        ],
        "Tools": [],
        "HistoryLength": 3,
        "VisionConfig": {
          "Enable": true,
          "SnapshotConfig": {
            "StreamType": 1,
            "ImageDetail": "high",
            "Height": 1080,
            "Interval": 1000,
            "ImagesLimit": 1
          }
        },
        "ThinkingType": "auto",
        "Url": "https://token-plan-cn.xiaomimimo.com/v1/chat/completions",
        "APIKey": "${MIMO_API_KEY}",
        "ModelName": "mimo-v2.5"
      },
      "TTSConfig": {
        "Provider": "volcano_bidirection",
        "ProviderParams": {
          "Credential": {
            "AppId": "${VOLC_TTS_APP_ID}",
            "Token": "${VOLC_TTS_ACCESS_TOKEN}",
            "ResourceId": "seed-icl-2.0"
          },
          "VolcanoTTSParameters": "{\"req_params\":{\"speaker\":\"${VOLC_S2S_SPEAKER_ID}\",\"audio_params\":{\"speech_rate\":0},\"additions\":{\"disable_markdown_filter\":true}}}"
        }
      },
      "SubtitleConfig": {
        "SubtitleMode": 1
      },
      "InterruptMode": 3
    },
    "AgentConfig": {
      "WelcomeMessage": "哦，你来了"
    }
  },
  "WebSearchOpenAPI": {
    "Enabled": false
  }
}
